NEXT_PUBLIC_SITE_URL=https://www.sabocon.com
# Keep false until final content, legal information and hosting have been reviewed.
PUBLISH_SITE=false

# Sanity: public project identifiers, not passwords.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only secrets; never use NEXT_PUBLIC_ for these.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
CMS_PREVIEW_SECRET=
LINKEDIN_IMPORT_SECRET=
# Enable only after permitted LinkedIn use and import checks. Default: drafts.
LINKEDIN_IMPORT_PUBLISH=false
